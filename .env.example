# ElevenLabs Scribe (verbatim word-level transcription). Optional — the app
# works without it (algorithmic and manual cut modes stay available).
ELEVENLABS_API_KEY=

# Development override only. Production and normal local installs use the
# pinned HyperFrames CLI bundled with the Studio.
HYPERFRAMES_BIN=

# --- macOS desktop distribution (only needed to ship a build to someone else) ---
# Without both of these, `pnpm desktop:make` still succeeds, but signs ad-hoc:
# macOS then refuses the result on any machine other than the one that built it.
#
# The exact name of your Developer ID certificate, from
# `security find-identity -v -p codesigning`.
MACOS_SIGN_IDENTITY=
# A notarization profile stored in the Keychain with
# `xcrun notarytool store-credentials <name> --apple-id <you> --team-id <team>`.
# The app-specific password stays in the Keychain; it never belongs in this file.
APPLE_KEYCHAIN_PROFILE=
# Alternatives to the profile, if you prefer: an App Store Connect API key
# (APPLE_API_KEY, APPLE_API_KEY_ID, APPLE_API_ISSUER) or the Apple ID trio
# (APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD, APPLE_TEAM_ID).

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist/node",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/core", "src/db", "src/application", "src/server", "src/cli"],
  "exclude": ["**/*.test.ts", "**/*.integration.test.ts"]
}
